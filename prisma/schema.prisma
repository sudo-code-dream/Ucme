generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  PENDING
  ACTIVE
  MATCHED
  RESOLVED
  EXPIRED
}


enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id            String         @id @default(cuid())
  ucId          String         @unique
  firstName     String
  middleName    String?
  lastName      String
  suffix        String?
  email         String         @unique
  contact       String
  campus        String
  college       String
  program       String
  yearLevel     String
  section       String?
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  reports       Report[]
  claims        Claim[]
  saved         SavedItem[]
  notifications Notification[]
  flags         Flag[]
  emailVerified   DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  sessionVersion  Int       @default(0)
  tokens          AuthToken[]
  emailAlerts Boolean @default(true)
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Report {
  id          String       @id @default(cuid())
  ref         String       @unique
  type        ReportType
  status      ReportStatus @default(ACTIVE)
  title       String
  category    String
  location    String
  occurredOn  DateTime
  approxTime  String?
  description String
  // PRIVATE: shown only to the owner/staff, never on public pages
  features    String
  photoUrl    String?
  // found reports only
  keptAt      String?
  hidden      Boolean      @default(false)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  claims      Claim[]
  saved       SavedItem[]
  flags       Flag[]
  createdAt   DateTime     @default(now())
  notifications Notification[]

  @@index([type, status, category])
}

model Claim {
  id           String      @id @default(cuid())
  reportId     String
  claimantId   String
  // PRIVATE ownership details; visible only to the report owner
  verification String
  status       ClaimStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  report       Report      @relation(fields: [reportId], references: [id])
  claimant     User        @relation(fields: [claimantId], references: [id])
}

model SavedItem {
  userId   String
  reportId String
  user     User   @relation(fields: [userId], references: [id])
  report   Report @relation(fields: [reportId], references: [id])

  @@id([userId, reportId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ucId      String
  createdAt DateTime @default(now())

  @@index([ucId, createdAt])
}

model Flag {
  id         String   @id @default(cuid())
  reportId   String
  reporterId String
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  report     Report   @relation(fields: [reportId], references: [id])
  reporter   User     @relation(fields: [reporterId], references: [id])

  @@unique([reportId, reporterId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
